VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set true to use local demo data without Firebase or Google Sheets.
VITE_DEMO_MODE=false

# Required for the AI receipt scanner. Without it, scanning reports "Scanner not configured"
# and you enter expenses manually. WARNING: PayTrack has no backend, so anything VITE_* is
# compiled into the JavaScript bundle and visible to anyone who loads the app. Use a key
# restricted to the Generative Language API (and to your own domain), never an unrestricted
# one. If you already pasted a key into localStorage["paytrack.geminiApiKey"] that still
# works, but this variable takes precedence.
VITE_GEMINI_API_KEY=

# Optional: override the vision model used by the AI receipt scanner.
# Defaults to gemini-2.5-flash. Set this if your API key needs a different model.
VITE_GEMINI_MODEL=
